{
  "name": "tls",
  "version": "0.1.0",
  "description": "TLS Secure Messaging – encrypted two-person chat",
  "main": "server.ts",
  "type": "commonjs",
  "scripts": {
    "start":    "tsx server.ts",
    "build":    "tsc",
    "dev":      "tsx watch server.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^12.9.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
