{
  "name": "tls",
  "version": "1.6.1",
  "description": "TLS Secure Messaging – encrypted two-person chat",
  "main": "server.ts",
  "type": "commonjs",
  "scripts": {
    "preinstall": "node scripts/check-platform.cjs --runtime-only",
    "prestart": "node scripts/check-platform.cjs --runtime-only",
    "start": "tsx server.ts",
    "build": "tsc",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit",
    "database": "tsx scripts/database.ts",
    "test:database": "tsx --test tests/database.test.ts",
    "test:server": "tsx --test tests/startup.test.ts",
    "check:platform": "node scripts/check-platform.cjs"
  },
  "engines": {
    "node": ">=22 <27"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "@tls/sqlite-arm32": "file:platform/sqlite-arm32"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers@12.9.0": true,
    "better-sqlite3-multiple-ciphers@13.0.3": false,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true
  }
}
