{
  "name": "tls",
  "version": "1.6.1",
  "description": "TLS Secure Messaging – encrypted two-person chat",
  "main": "server.ts",
  "type": "commonjs",
  "scripts": {
    "start": "tsx server.ts",
    "build": "tsc",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers@13.0.3": true,
    "esbuild@0.28.1": true
  }
}
