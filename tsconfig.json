{
  "compilerOptions": {
    "target":                          "ES2022",
    "module":                          "commonjs",
    "moduleResolution":                "node10",
    "ignoreDeprecations":              "6.0",
    "lib":                             ["ES2022"],
    "outDir":                          "./dist",
    "rootDir":                         "./",
    "strict":                          true,
    "esModuleInterop":                 true,
    "skipLibCheck":                    true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule":               true,
    "declaration":                     true,
    "declarationMap":                  true,
    "sourceMap":                       true
  },
  "include": [
    "**/*.ts",
    "typings/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public"
  ]
}
