# ─── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file (will be created on first run)
DB_PATH=./data/tls.db

# 256-bit AES encryption key for the SQLite database (SQLCipher).
# Any string is accepted; it is hashed to 32 bytes internally.
# Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=CHANGE_ME_generate_a_strong_random_key_here

# ─── Initial admin account (used only when seeding the database) ────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_DISPLAY_NAME=Administrator

# ─── Server ─────────────────────────────────────────────────────────────────────
PORT=3333

# ─── Cloudflare Turnstile ────────────────────────────────────────────────────────
# Leave blank to disable Turnstile verification (development mode)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── SMTP (for 2FA OTP and invite emails) ───────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true = direct TLS (port 465); false = plain / STARTTLS (port 587/25)
SMTP_SECURE=false
# true = require STARTTLS upgrade even if server offers plain text
SMTP_STARTTLS=true
SMTP_USER=user@example.com
SMTP_PASSWORD=your-smtp-password
# From address shown to recipients
SMTP_FROM=TLS <noreply@example.com>

# ─── Application domain (used in invite/OTP emails) ─────────────────────────────
APP_URL=https://tls.jahosi.co.uk

# ─── VAPID (Web Push Notifications) ─────────────────────────────────────────────
# Generate a new VAPID key pair with:
#   node -e "const wp = require('web-push'); const k = wp.generateVAPIDKeys(); console.log(k)"
# Leave blank to disable push notification support entirely.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
